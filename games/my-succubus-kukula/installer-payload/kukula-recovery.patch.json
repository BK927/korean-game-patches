      "operations": [
        {
          "op": "insert_after",
          "after": "end_1_7",
          "key": "end_1_8",
          "old": null,
          "new": "「뭐?! 내가 미숙하다고? 죽고 싶어?!」"
        },
        {
          "op": "update",
          "key": "end_4_6",
          "old": "몸의 뼈가 전부 빠져나갈 것만 같다.",
          "new": "온몸의 뼈가 다 산산이 부서질 것만 같았다."
        },
        {
          "op": "update",
          "key": "end_5_9",
          "old": "하지만 곁에서 들리는 소리는 희미하게나마 들렸다.",
          "new": "하지만 곁의 소리가 희미하게 들려왔다."
        },
        {
          "op": "update",
          "key": "end_7_2",
          "old": "「야, 나 지금 아주 많이 화났거든. 알고 있어?」",
          "new": "「야, 나 지금 엄청 화난 거, 알고 있어?」"
        },
        {
          "op": "update",
          "key": "true_end_9",
          "old": "「한번은 커다란 늑대가 날 쫓아와 물려고 했는데, 그때 네가 나서서 구해줬잖아.」",
          "new": "한 번은 커다란 늑대가 날 쫓아와 물려고 했는데, 그때 네가 나서서 구해줬잖아."
        },
        {
          "op": "update",
          "key": "true_end_29",
          "old": "「으악, 급해서 널 이렇게 만들어버렸어!」",
          "new": "「우와, 급한 나머지 널 이렇게 만들어버렸어!」"
        },
        {
          "op": "update",
          "key": "true_end_31",
          "old": "「내가 너랑 같이 있는 걸 보여주면 안 돼.」",
          "new": "「걔들이 내가 너랑 같이 있는 걸 보면 안 돼.」"
        },
        {
          "op": "update",
          "key": "true_end_35",
          "old": "「넌 나를 뭐든지로 바꿀 수 있어?」",
          "new": "「넌 나를 뭐든지로 변신시킬 수 있어?」"
        },
        {
          "op": "update",
          "key": "true_end_37",
          "old": "「부탁이야, 나도 악마로 바꿔줘.」",
          "new": "「부탁이야, 나도 악마로 만들어 줘.」"
        },
        {
          "op": "update",
          "key": "true_end_43",
          "old": "-- 여름방학이 끝나기 전날까지.",
          "new": "—— 여름방학이 끝나기 전날까지."
        },
        {
          "op": "update",
          "key": "true_end_47",
          "old": "「알았어, 약속할게.」",
          "new": "「그래, 약속할게.」"
        },
        {
          "op": "update",
          "key": "true_end_59",
          "old": "「안 돼, 계약이 없으면, 그럼--」",
          "new": "「안 돼, 계약이 없으면, 그럼——」"
        },
        {
          "op": "update",
          "key": "true_end_64",
          "old": "그 후--",
          "new": "그 후——"
        },
        {
          "op": "update",
          "key": "true_end_73",
          "old": "「아, 왜 갑자기 안기는 건데!」",
          "new": "「아, 왜 갑자기 껴안는 건데!」"
        },
        {
          "op": "update",
          "key": "true_end_75",
          "old": "「네가 그렇게 날 좋아한다면, 특별히 상을 하나 줄게.」",
          "new": "「네가 그렇게 날 좋아한다면, 마지못해 상 하나 줄게.」"
        },
        {
          "op": "update",
          "key": "true_end_79",
          "old": "「대바보.」",
          "new": "「왕바보.」"
        }
      ]
    }
  ]
}
