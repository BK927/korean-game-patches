      "result_override_sha256": "C3F351E97203DEAC4D98842828ABDB4C8008AD731EF860DCA41A31A71F5F7006",
      "base_map_sha256": "93EA00EB0534E56ADFA6DBF46141CBBDB90F506D0F50ACE57B51D41A0B70E77F",
      "result_map_sha256": "30C16ED5337B7F5040FB9ECF4D060DFB5C823F58F5152E4B89A18DA19F9A12CF",
      "base_map_count": 329,
